#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config LVX_USE_DEMO_CONTEST2026_325_SILVER_GUARDIAN_HUB
	bool "Silver Guardian Hub (elderly care)"
	default n
	---help---
		Enable Silver Guardian Hub application for elderly care.

		Single-board interactive features (no wristband or cloud required):
		- Touch-driven multi-page UI (home / menu / medication / health /
		  events / settings / about / touch self-test)
		- Medication reminder with plans persisted to /data
		- On-board I2C sensors: SHTC3 (temp/humi), LTR553 (light/prox),
		  SGP30 (CO2/TVOC)
		- Local alert tones generated in code (no audio files needed)
		- SOS / sitting alerts with an overlay on top of every page

		Fonts: the app ships its own GB2312 Chinese bitmap fonts
		(src/fonts/, generated by tools/gen_lvgl_fonts.sh). Do NOT rely on
		LV_FONT_SIMSUN_16_CJK -- that example font only carries 1166 CJK
		glyphs and cannot render "银发守护".
